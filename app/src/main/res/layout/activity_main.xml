<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="StopScroll"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:textSize="15sp" />

        <!-- STAV SLUŽBY -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Otvoriť nastavenia prístupnosti" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.7"
            android:textSize="13sp"
            android:text="Je prepínač sivý a nedá sa zapnúť? Otvor informácie o aplikácii, vpravo hore klikni na ⋮ a zvoľ „Povoliť obmedzené nastavenia“. Potom to skús znova." />

        <Button
            android:id="@+id/btnAppInfo"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Informácie o aplikácii" />

        <!-- NASTAVENIA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Čo blokovať"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/swInstagram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="Instagram Reels"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/swYoutube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="YouTube Shorts"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/swDmOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Instagram len na správy"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:textSize="13sp"
            android:text="Feed, vyhľadávanie, Reels a profily ťa hneď vrátia do správ. Fotoaparát, galéria a hovory fungujú normálne." />

        <TextView
            android:id="@+id/limitLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/limitBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="29" />

        <!-- ŠTATISTIKA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Štatistika"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="15sp" />

        <!-- LADENIE -->
        <Switch
            android:id="@+id/swDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="48dp"
            android:text="Režim ladenia"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/debugHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:textSize="13sp"
            android:text="Ak appka niečo nerozpozná: zapni ladenie, otvor danú obrazovku (Reels, Shorts, správy...) aspoň na 3 sekundy, vráť sa sem a skopíruj text nižšie. Pri ladení režimu len správy ho najprv vypni, inak ťa bude presmerúvať." />

        <TextView
            android:id="@+id/debugText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCopy"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kopírovať" />

        <!-- VLASTNÉ ID -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Pokročilé: vlastné ID"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:textSize="13sp"
            android:text="Doplnia sa k zabudovaným. Oddeľ ich čiarkou. Netreba nič znova inštalovať – stačí Uložiť." />

        <EditText
            android:id="@+id/edReel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="ID prehrávača Instagram Reels"
            android:inputType="textNoSuggestions|textMultiLine"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edShorts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID prehrávača YouTube Shorts"
            android:inputType="textNoSuggestions|textMultiLine"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edDm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID obrazovky správ (Instagram)"
            android:inputType="textNoSuggestions|textMultiLine"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edInboxBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID tlačidla správ (Instagram)"
            android:inputType="textNoSuggestions|textMultiLine"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSaveIds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Uložiť ID" />

    </LinearLayout>
</ScrollView>
